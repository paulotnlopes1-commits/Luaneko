-- Este script lê os seus links do GitHub e executa um por um.

local links = {
    "https://raw.githubusercontent.com/paulotnlopes1-commits/Normalmente5/refs/heads/main/1439878",
    "https://raw.githubusercontent.com/paulotnlopes1-commits/Normalmente4/refs/heads/main/145234",
    "https://raw.githubusercontent.com/paulotnlopes1-commits/Normalmente3/refs/heads/main/44388789",
    "https://raw.githubusercontent.com/paulotnlopes1-commits/Normalmente2/refs/heads/main/1134214",
    "https://raw.githubusercontent.com/paulotnlopes1-commits/Normalmente1/refs/heads/main/Nsei"
}

print("Iniciando o carregamento dos scripts...")

for i, url in ipairs(links) do
    local success, result = pcall(function()
        -- O Delta usa 'game:HttpGet' para ler o conteúdo de sites
        return game:HttpGet(url)
    end)

    if success and result then
        print("Carregado script " .. i .. " com sucesso!")
        
        -- 'loadstring' transforma o texto do site em código funcional
        local exec, err = loadstring(result)
        if exec then
            exec() -- Executa o código
        else
            warn("Erro ao transformar texto em script " .. i .. ": " .. tostring(err))
        end
    else
        warn("Falha ao baixar o script da URL " .. i .. ": " .. tostring(result))
    end
end

print("Todos os scripts foram processados, Rei amiga!")
