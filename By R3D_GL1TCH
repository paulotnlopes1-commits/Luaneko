-- FUNÇÃO: Verifica se o corpo é o clássico quadrado (R6)
local function eQuadrado(char)
    if char:FindFirstChild("Torso") and not char:FindFirstChild("UpperTorso") then
        return true -- É R6 Quadrado
    end
    return false
end

-- FUNÇÃO: Executa o script em um alvo específico
local function executarNoAlvo(url, alvo)
    local success, scriptText = pcall(function() return game:HttpGet(url) end)
    if success then
        -- Substituindo referências globais para o alvo selecionado dentro do script carregado
        _G.SelectedTarget = alvo
        local exec = loadstring(scriptText)
        if exec then pcall(exec) end
    end
end

